rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Anyone can read basic user profile info (e.g. author name/avatar)
      allow read: if true;
      // Only the user can create or update their own profile document
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Images Collection (Gallery)
    match /images/{imageId} {
      // Unauthenticated & Authenticated users can browse/read all gallery images
      allow read: if true;

      // Authenticated users can create images, but userId must match their auth UID
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0;

      // Authenticated users can ONLY update their own image documents
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Authenticated users can ONLY delete their own image documents
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }

    // 3. Notifications Collection
    match /notifications/{notificationId} {
      // Only the notification recipient can read or update (mark read)
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // System or authenticated actions can create notifications
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
