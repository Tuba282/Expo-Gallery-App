rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024; // Max 15MB
    }

    // Public Gallery Images storage path: images/{userId}/{fileName}
    match /images/{userId}/{fileName} {
      // Unauthenticated & Authenticated users can view/download images
      allow read: if true;

      // Only the authenticated owner can upload images into their own folder
      allow create: if isOwner(userId) && isImageFile();

      // Only the authenticated owner can overwrite or update their image
      allow update: if isOwner(userId) && isImageFile();

      // Only the authenticated owner can delete their image
      allow delete: if isOwner(userId);
    }
  }
}
